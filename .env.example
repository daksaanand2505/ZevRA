PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PayPal Sandbox credentials from developer.paypal.com
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: required to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/zevra?retryWrites=true&w=majority

# Optional: Member 1's AI prediction API.
# Keep blank until Member 1 provides the endpoint.
AI_API_URL=
AI_API_KEY=
